{
  "name": "credora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "start:frontend": "next dev",
    "start:backend": "cd backend && .\\venv\\Scripts\\Activate.ps1 && python -m app.main",
    "dev:all": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
